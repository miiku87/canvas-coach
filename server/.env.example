# Anthropic API key (or use `ant auth login` instead)
ANTHROPIC_API_KEY=

# Canvas origin(s) allowed to call this server, comma separated
ALLOWED_ORIGINS=https://yourschool.instructure.com

# Optional shared token; set the same value in the widget config
COACH_ACCESS_TOKEN=

PORT=8787
COACH_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
COACH_EFFORT=medium
COACH_LANGUAGE=suomi
COACH_RATE_LIMIT=20
